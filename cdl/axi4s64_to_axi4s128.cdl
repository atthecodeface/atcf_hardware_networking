 * @file   axi4s_process.cdl
 * @brief  AXI pipeline with a process function invoked on the first N AXI4s words
 *
 * CDL implementation of an arbitrary AXI4S header processor
 *
 */
/*a Includes
 */
include "utils::fifo_status.h"
include "axi4s.h"
include "axi4s_modules.h"

/*t t_ib_combs */
typedef struct {
    bit[2] valid;
    bit[2] would_consume;
    bit[2] consume;
    bit push;
} t_ib_combs;

/*a Module */
module axi4s64_to_axi4s128( clock clk         "System clock",
                           input bit reset_n "Active low reset",

                           input t_axi4s64  rx_axi4s,
                           output bit       rx_axi4s_tready,
                           input bit        tx_axi4s_tready,
                           output t_axi4s128 tx_axi4s
    )
"""
Width converter from 64-bit to 128-bit AXI4s

Drops alternate user/dest fields

Merges 
"""
{
    /*b Clock and reset */
    default clock clk;
    default reset active_low reset_n;

    net t_axi4s128 tx_axi4s;

    clocked t_axi4s64[2]  input_buf = {*=0} "Buffer including valid bits; input to the lowest available slot, output at 0";
    comb    t_ib_combs    ib_combs;

    comb t_axi4s128 ob_axi4s;
    net bit ob_tready;
    net t_fifo_status ob_fifo_status;

    /*b AXI4S interfaces */
    axi4s_interfaces """
    """ : {
        rx_axi4s_tready = (ib_combs.valid != 2b11) || ob_tready;
    }

    /*b Input buffer */
    input_buffer_logic """
    This uses a pair of input registers; it can consume neither, one, or both in a single cycle
    """ : {
        ib_combs.push = rx_axi4s_tready && rx_axi4s.valid;
        ib_combs.valid[0] = input_buf[0].valid;
        ib_combs.valid[1] = input_buf[1].valid;

        ib_combs.would_consume = 0;

        ob_axi4s = {*=0};
        ob_axi4s.t.last = input_buf[0].t.last;
        ob_axi4s.t.id   = input_buf[0].t.id;
        ob_axi4s.t.user = input_buf[0].t.user;
        ob_axi4s.t.dest = input_buf[0].t.dest;

        ob_axi4s.t.data0 = input_buf[0].t.data;
        ob_axi4s.t.strb[8; 0] = input_buf[0].t.strb;
        ob_axi4s.t.keep[8; 0] = input_buf[0].t.keep;

        if (input_buf[0].t.last) {
            if (ib_combs.valid[0]) {
                ob_axi4s.valid = 1;
                ib_combs.would_consume[0] = 1;
            }
        } else {
            if (ib_combs.valid == 2b11) {
                ob_axi4s.valid = 1;
                ib_combs.would_consume = -1;
            }
            ob_axi4s.t.last = input_buf[1].t.last;
            ob_axi4s.t.data1 = input_buf[1].t.data;
            ob_axi4s.t.strb[8; 8] = input_buf[1].t.strb;
            ob_axi4s.t.keep[8; 8] = input_buf[1].t.keep;
            if (input_buf[1].t.user != 0) {
                ob_axi4s.t.user = input_buf[1].t.user;
            }
        }

        ib_combs.consume = 0;
        if (ob_tready && ob_axi4s.valid) {
            ib_combs.consume = ib_combs.would_consume;
        }

        if (ib_combs.consume == 2b11) {
            input_buf[0].valid <= 0;
            input_buf[1].valid <= 0;
            if (ib_combs.push) {
                input_buf[0] <= rx_axi4s;
            }
        } elsif (ib_combs.consume == 2b01) {
            input_buf[0] <= input_buf[1];
            input_buf[1].valid <= 0;
            if (ib_combs.push) {
                if (input_buf[1].valid) {
                    input_buf[1] <= rx_axi4s;
                } else {
                    input_buf[0] <= rx_axi4s;
                }
            }
        } elsif (ib_combs.push) {
            if (input_buf[0].valid) {
                input_buf[1] <= rx_axi4s;
            } else {
                input_buf[0] <= rx_axi4s;
            }
        }
    }

    /*b Output buffer */
    output_double_buffer """
        Instantiate a double-buffer for the output
    """ : {
        axi4s128_double_buffer output_buffer( clk <- clk, reset_n <= reset_n,
                                             req_in <= ob_axi4s,
                                             ack_in => ob_tready,
                                             req_out => tx_axi4s,
                                             ack_out <= tx_axi4s_tready,
                                             fifo_status => ob_fifo_status );
    }

    /*b Done
     */
}

