 * @file   apb_target_sram_interface.cdl
 * @brief  APB bus target to drive an SRAM read/write request
 *
 * CDL implementation of a simple APB target to interface to an SRAM
 * read/write request/response bus.
 *
 */
/*a Includes
 */
include "std::srams.h"
include "utils::sram_access.h"
include "apb::apb.h"
include "apb::apb_targets.h"
include "apb::apb_masters.h"
include "axi4s.h"
include "axi4s_modules.h"

/*a Constants */

/*a Module */
module tb_axi_debug_apb( clock clk         "System clock",
                         input bit reset_n "Active low reset",
                             
                         input  t_apb_request  apb_request  "APB request",
                         output t_apb_response apb_response "APB response",

                         output bit       th_axi4s_tready,
                         input t_axi4s32  th_axi4s,
                         output t_axi4s32 dut_axi4s,
                         input bit        dut_axi4s_tready
                             
    )
{
    net t_apb_response apb_response "APB response";
    net bit       th_axi4s_tready;

    net t_apb_request  axi_apb_request  "APB request";
    net t_apb_response axi_apb_response "APB response";
    net t_apb_request  muxed_apb_request  "APB request";
    net t_apb_response muxed_apb_response "APB response";

    net t_axi4s64 rx_axi4s64;
    net bit       rx_axi4s64_tready;

    net t_axi4s128 rx_axi4s128;
    net bit       rx_axi4s128_tready;

    net t_axi4s64 apb_axi4s64;
    net bit       apb_axi4s64_tready;

    net t_axi4s64 res_axi4s64;
    net bit       res_axi4s64_tready;

    net t_axi4s32 dut_axi4s;

    net  t_sram_access_req  sram_req;
    comb t_sram_access_resp sram_resp;
    net bit[32] sram_data_out;

    default clock clk;
    default reset active_low reset_n;
    clocked bit sram_did_read = 0;

    code: {
        axi4s32_to_axi4s64 axi_widen_to_64( clk <- clk,
                            reset_n <= reset_n,
                            rx_axi4s <= th_axi4s,
                            rx_axi4s_tready => th_axi4s_tready,
                            tx_axi4s => rx_axi4s64,
                            tx_axi4s_tready <= rx_axi4s64_tready
            );
        axi4s64_to_axi4s128 axi_widen_to_128( clk <- clk,
                            reset_n <= reset_n,
                            rx_axi4s <= rx_axi4s64,
                            rx_axi4s_tready => rx_axi4s64_tready,
                            tx_axi4s => rx_axi4s128,
                            tx_axi4s_tready <= rx_axi4s128_tready
            );

        axi4s128_to_axi4s64 axi_narrow_to_64( clk <- clk,
                            reset_n <= reset_n,
                            rx_axi4s <= rx_axi4s128,
                            rx_axi4s_tready => rx_axi4s128_tready,
                            tx_axi4s => apb_axi4s64,
                            tx_axi4s_tready <= apb_axi4s64_tready
            );

        axi4s64_apb_master axi_to_apb( clk <- clk,
                                      reset_n <= reset_n,
                                      rx_axi4s <= apb_axi4s64,
                                      rx_axi4s_tready => apb_axi4s64_tready,
                                      tx_axi4s => res_axi4s64,
                                      tx_axi4s_tready <= res_axi4s64_tready,
                                      apb_request => axi_apb_request,
                                      apb_response <= axi_apb_response
            );
               
        axi4s64_to_axi4s32 axi_narrow_to_32( clk <- clk,
                            reset_n <= reset_n,
                            rx_axi4s <= res_axi4s64,
                            rx_axi4s_tready => res_axi4s64_tready,
                            tx_axi4s => dut_axi4s,
                            tx_axi4s_tready <= dut_axi4s_tready
            );

        apb_master_mux apb_mux( clk <- clk,
                        reset_n <= reset_n,
                        apb_request_0 <= axi_apb_request,
                        apb_response_0 => axi_apb_response,
                        apb_request_1 <= apb_request,
                        apb_response_1 => apb_response,
                        apb_request => muxed_apb_request,
                        apb_response <= muxed_apb_response );

        apb_target_sram_interface sram_apb( clk <- clk,
                                            reset_n <= reset_n,
                                            apb_request  <= muxed_apb_request,
                                            apb_response  => muxed_apb_response,
                                            // sram_ctrl => ,
                                            sram_access_req  => sram_req,
                                            sram_access_resp <= sram_resp );

        se_sram_srw_65536x32 sram( sram_clock <- clk,
                                   select <= sram_req.valid,
                                   address <= sram_req.address[16;0],
                                   read_not_write <= sram_req.read_not_write,
                                   write_enable <= !sram_req.read_not_write,
                                   write_data <= sram_req.write_data[32;0],
                                   data_out => sram_data_out );
        sram_resp = {*=0};
        sram_resp.ack = 1; // dedicated to sram access ports
        sram_resp.data[32;0]  = sram_data_out;
        sram_resp.valid = sram_did_read;
        sram_did_read <= sram_req.valid && sram_req.read_not_write;

    }
}
